<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8.0+ adaptive icon.
    Foreground: speech bubbles + music note on transparent background.
    Background: pink-to-deep-red gradient rounded square.
    PNG layers live in android/res/mipmap-*/ (one per density).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
</adaptive-icon>
